  "infrastructure": {
    "exceptions": [
      "postgres",
      "redis",
      "nats",
      "influxdb",
      "api-gateway",
      "otel-collector",
      "prometheus",
      "jaeger",
      "grafana",
      "adminer",
      "portainer"
    ],
    "rationale": "Infrastructure and observability services are environment-specific and not driven by service registry",
    "dev_port_generation": {
      "base_port": 18000,
      "fixed_ports": {
        "api_gateway": 8080,
        "web_ui": 3000,
        "admin_ui": 3006,
        "jaeger_ui": 16686
      },
      "generated_ports": {
        "nats_client": 0,
        "nats_http": 1,
        "grafana": 2,
        "adminer": 3,
        "portainer": 4
      },
      "default_ports": {
        "postgres": 5432,
        "redis": 6379,
        "influxdb": 8086,
        "otel_grpc": 4317,
        "otel_http": 4318
      },
      "port_env_vars": {
        "api_gateway": "API_GATEWAY_HOST_PORT",
