# Example RKE2 deployment values for Vista Platform.
# Copy to config/rke2/values.env (gitignored) and edit, OR run
# scripts/deploy-rke2-interactive.sh which generates values.env interactively.

# ---------------------------------------------------------------------------
# Container image source
# ---------------------------------------------------------------------------
# Default registry is the existing Vista Platform ECR. Switch to GHCR or a private
# registry (e.g. Harbor on RKE2) by changing IMAGE_REGISTRY and IMAGE_REPO_PREFIX.
#
# Examples:
#   IMAGE_REGISTRY="ghcr.io"
#   IMAGE_REPO_PREFIX="vistasecurity/vistaplatform"
#
#   IMAGE_REGISTRY="harbor.internal.example.com"
#   IMAGE_REPO_PREFIX="vistaplatform"
IMAGE_REGISTRY="docker.io"
IMAGE_REPO_PREFIX="crypto-inventory"
IMAGE_TAG="latest"

# Optional: image pull secret name. Create it separately, e.g.
#   kubectl create secret docker-registry vistaplatform-pull -n crypto-inventory \
#     --docker-server=$IMAGE_REGISTRY --docker-username=... --docker-password=...
# Leave empty if the registry is public or the cluster nodes have IAM/keychain access.
IMAGE_PULL_SECRET=""

# ---------------------------------------------------------------------------
# Hostnames
# ---------------------------------------------------------------------------
# DNS records (or /etc/hosts entries) for these names must point at any node
# of the RKE2 cluster (where the bundled Traefik IngressController listens on
# 80/443).
CLUSTER_DOMAIN="vistaplatform.local"
API_HOST="api.vistaplatform.local"
APP_HOST="app.vistaplatform.local"
ADMIN_HOST="admin.vistaplatform.local"

# Scheme used by the frontends to talk to the API gateway (http or https).
# Set to "https" only after enabling TLS in k8s/rke2/08-ingress.yaml.
API_SCHEME="http"

# ---------------------------------------------------------------------------
# Datastore mode
# ---------------------------------------------------------------------------
# in-cluster -> deploy Postgres/Redis/InfluxDB via k8s/rke2/02-datastores.yaml
# external   -> use the EXTERNAL_* URLs below; 02-datastores.yaml is skipped
DATASTORE_MODE="in-cluster"

# Used only when DATASTORE_MODE=external. Leave commented otherwise.
# EXTERNAL_DATABASE_URL="postgres://crypto_user:PASSWORD@db.example.com:5432/crypto_inventory?sslmode=require"
# EXTERNAL_REDIS_URL="rediss://:PASSWORD@redis.example.com:6379/0"
# EXTERNAL_INFLUX_URL="https://influx.example.com:8086"

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# The install script writes these into the crypto-inventory-secrets Secret.
# Leave any value blank to have the script generate a random one (recommended).
JWT_SECRET=""
INTERNAL_AUTH_SECRET=""
ENCRYPTION_MASTER_KEY=""

# In-cluster Postgres password. Used to seed POSTGRES_PASSWORD on the StatefulSet
# AND to build the in-cluster DATABASE_URL secret. Ignored in external mode.
POSTGRES_PASSWORD=""

# In-cluster InfluxDB admin token. Used to seed the StatefulSet and to populate
# the influx-token secret consumed by services. Ignored in external mode.
INFLUX_TOKEN=""

# ---------------------------------------------------------------------------
# Database schema / seed
# ---------------------------------------------------------------------------
# When true, the install script applies scripts/database/schema.sql (and seed)
# against the deployed Postgres after it becomes ready.
APPLY_DB_SCHEMA="true"
APPLY_DB_SEED="true"
