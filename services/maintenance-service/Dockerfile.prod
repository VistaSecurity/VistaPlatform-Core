# Production Dockerfile for Maintenance Service (Core; platform backups and updates)
ARG GO_BUILDER_IMAGE=golang:1.26.9-alpine
ARG RUNTIME_IMAGE=alpine:3.24.2
FROM ${GO_BUILDER_IMAGE} AS builder

WORKDIR /workspace
RUN apk add --no-cache ca-certificates tzdata git

# Explicitly enable workspace mode
ENV GOWORK=/workspace/go.work
ENV GOTOOLCHAIN=go1.26.9

# Copy workspace files in correct order
COPY go.work ./
COPY shared ./shared
COPY shared/rbac ./shared/rbac
COPY services ./services
COPY sensor ./sensor
COPY device-agent ./device-agent
# Build from workspace root with optimizations
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/main ./services/maintenance-service/cmd

# helm + cosign for the update and rollback Jobs (spec platform-maintenance.md
# WP4). The Job runs this same image as the vistaplatform-updater
# ServiceAccount, and the service runs `cosign verify` in-process during
# pre-flight. Pinned versions, verified against hardcoded SHA-256 sums per
# architecture — a bump changes the version AND both sums together:
#   helm   v3.22.1  https://get.helm.sh/helm-v3.22.1-linux-<arch>.tar.gz.sha256sum
#                   (cross-checked against the v3.22.1 GitHub release notes)
#   cosign v3.1.3   https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign_checksums.txt
# Sums taken from upstream's published files on 2026-10-18. cosign is v3 because
# v2's last release (2.6.5) still carries the HIGH/CRITICAL dependency CVEs; only
# `cosign verify` is used here (unchanged flags), and v3 still verifies the
# legacy-format signatures release-core.yml / release-customer.yml create with
# v2 (those jobs keep signing with v2: sign-blob --output-signature is gone in
# v3). Helm stays on 3.x (4.x changed --wait to kstatus and the updater Role is
# sized for 3.x).
FROM ${GO_BUILDER_IMAGE} AS tools
ARG TARGETARCH
RUN apk add --no-cache ca-certificates curl
RUN set -eu; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in \
      amd64) helm_sha=896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea; cosign_sha=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71 ;; \
      arm64) helm_sha=4c29e286b279d170fa048ddfc3e4e83dcd069ca9c52102766ba672d7149e694d; cosign_sha=c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a ;; \
      *) echo "unsupported TARGETARCH: $arch" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out /tmp/helm; \
    curl -fsSL -o /tmp/helm.tgz "https://get.helm.sh/helm-v3.22.1-linux-${arch}.tar.gz"; \
    echo "${helm_sha}  /tmp/helm.tgz" | sha256sum -c -; \
    tar -xzf /tmp/helm.tgz -C /tmp/helm; \
    install -m 0755 "/tmp/helm/linux-${arch}/helm" /out/helm; \
    curl -fsSL -o /tmp/cosign "https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-${arch}"; \
    echo "${cosign_sha}  /tmp/cosign" | sha256sum -c -; \
    install -m 0755 /tmp/cosign /out/cosign; \
    rm -rf /tmp/helm /tmp/helm.tgz /tmp/cosign

FROM ${RUNTIME_IMAGE}
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
RUN addgroup -g 1001 -S appgroup && adduser -u 1001 -S appuser -G appgroup
COPY --from=builder /out/main ./main
COPY --from=tools /out/helm /usr/local/bin/helm
COPY --from=tools /out/cosign /usr/local/bin/cosign
RUN chown appuser:appgroup ./main && chmod +x ./main
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1
CMD ["./main"]
