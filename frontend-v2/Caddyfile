# Caddy configuration for the Crypto Inventory Platform Vista tenant UI (frontend-v2)
# Serves the React SPA with caching, security headers, and API proxying

{
	auto_https off
	admin off
}

:3001 {
	root * /srv

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		# X-XSS-Protection is deprecated and can introduce vulns in legacy browsers;
		# "0" disables the legacy auditor. CSP below is the real defense.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP — same-origin everything. Tailwind requires style-src 'unsafe-inline'
		# (utility-class arbitrary-style injection). React+Vite production output
		# is a self-hosted bundle so script-src 'self' is sufficient. /api/* is
		# proxied through this same Caddy so connect-src 'self' covers it. Add an
		# external origin here rather than loosening 'self' if a future integration
		# needs one (CDN, analytics, etc.).
		Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		# HSTS — Caddy serves HTTP locally; when this image sits behind Traefik
		# HTTPS termination in the chart, this header passes through to the
		# browser and enforces HTTPS for one year on any subdomain. No `preload`
		# (would require an HSTS-preload submission).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Gzip compression
	encode gzip

	# Health check endpoint
	handle /health {
		respond "healthy" 200
	}

	# Config files - no caching for runtime config
	handle /config/* {
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		file_server
	}

	# Proxy API calls to the Traefik API gateway
	handle /api/* {
		reverse_proxy crypto-api-gateway:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				response_header_timeout 15s
			}
		}
	}

	# Hashed build output only — Vite content-hashes everything under /assets,
	# so immutable is safe there and ONLY there. Do not widen this matcher to
	# bare extensions (*.js, *.css): unhashed public files (/theme-init.js,
	# favicons) and index.html must revalidate, or a deployed upgrade keeps
	# serving the previous bundle from browser cache indefinitely. That
	# exact failure shipped: a stale cached index.html + immutable *.js kept
	# an old UI (missing the segment auto-approve toggle) alive across
	# deploys, and its saves silently wiped the flag.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, immutable, max-age=31536000"
		file_server
	}

	# SPA fallback - serve files or fall back to index.html. no-cache means
	# "revalidate before use" (ETag/304), not "never cache" — each navigation
	# picks up a new index.html immediately after a deploy.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
