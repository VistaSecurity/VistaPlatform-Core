# Production image for admin-ui-v2 — the Vista Admin Console.
#
# BUILD CONTEXT = REPO ROOT (not admin-ui-v2/). admin-ui-v2 is an npm workspace
# member that imports @vistasecurity/api-contract (api/) and
# @vistasecurity/primitives (packages/primitives/) as TypeScript SOURCE, so the
# build needs the root package.json/lock plus those workspaces. Build with:
#
#   docker build -f admin-ui-v2/Dockerfile.prod -t <image> .          # from repo root
#
# Like frontend-v2, this image bakes in NO API URL: the typed clients use
# relative /api/* paths (see api/clients/typescript/client.ts), so the UI is
# same-origin with the API behind Traefik in every environment — zero API config.
ARG NODE_BUILDER=node:24-alpine
ARG GO_BUILDER_IMAGE=golang:1.26.6-alpine
FROM ${NODE_BUILDER} AS builder
WORKDIR /repo

# Version metadata (parity with the About surface). Stamped at release time;
# defaults keep local builds meaningful.
ARG VITE_APP_VERSION=dev
ARG VITE_GIT_SHA=unknown
ARG VITE_BUILD_DATE=unknown
ENV VITE_APP_VERSION=$VITE_APP_VERSION \
    VITE_GIT_SHA=$VITE_GIT_SHA \
    VITE_BUILD_DATE=$VITE_BUILD_DATE

# Workspace sources first (all package.json must be present for `npm ci` to
# resolve the workspace tree against the root lockfile). node_modules is excluded
# by the root .dockerignore, so this is a clean install.
COPY package.json package-lock.json ./
COPY api/ ./api/
COPY packages/ ./packages/
COPY admin-ui-v2/ ./admin-ui-v2/
RUN npm ci
RUN npm run build -w admin-ui-v2

# ---- caddy build: compile Caddy on Go 1.26.6 with patched dependencies ----
# The stock caddy:2-alpine binary (even at 2.11.4) is compiled with Go stdlib
# 1.26.3, which Trivy still flags (CVE-2026-27145/-42504/-42507). Rebuild the
# Caddy binary ourselves on the repo's Go 1.26.6 toolchain so the runtime carries
# stdlib 1.26.6 (also clears GO-2026-5856/CVE-2026-42505). Pinned to Caddy v2.11.4
# (its own CVE fix).
#
# Why a wrapper module rather than `go install caddy@<newer>` (added 2026-08):
# v2.11.4 IS still the latest Caddy release, so there is no version to bump to —
# but three of the module versions its go.mod selects have been CVE'd since it
# was cut, and the nightly scan of the published images caught them:
#   golang.org/x/net       v0.55.0 → 0.56.0  CVE-2026-46600
#   golang.org/x/text      v0.37.0 → 0.39.0  CVE-2026-56852
#   google.golang.org/grpc v1.81.0 → 1.82.1  GHSA-hrxh-6v49-42gf
# `go install pkg@version` deliberately ignores any local go.mod, so it offers no
# lever to raise a transitive dependency: the only way to upgrade one is to build
# from a module we control. The three-line main package below is exactly what
# xcaddy generates for a custom build — caddycmd.Main() plus a blank import of
# modules/standard.
#
# That blank import is LOAD-BEARING. It is what registers file_server,
# reverse_proxy, encode, header, try_files and respond; a Caddy built without it
# compiles and runs but rejects both Caddyfiles at load time. If you touch this
# stage, re-run the container and confirm it actually serves — `caddy version`
# alone would still pass.
#
# The pins ratchet UP only. Each `go get` below raises a module the caddy go.mod
# would otherwise select at a vulnerable version; MVS takes the max, so these are
# floors, never downgrades. When a future Caddy release ships these versions or
# newer, the corresponding line becomes a no-op and can be dropped.
#
# GOTOOLCHAIN names the EXACT patch, for the same reason the service Dockerfiles
# do — but note the reason is NOT go.work compatibility. This stage compiles an
# unrelated module, so go.work's floor never applies and the build cannot fail
# here; it just silently produces a binary on whatever patch the base ships.
# release-core.yml overrides GO_BUILDER_IMAGE with a FLOATING tag
# (dhi.io/golang:1.26-alpine3.24-dev, or golang:1.26-alpine without Docker Hub
# creds), so `local` meant "whatever that tag serves today" — which was still
# 1.26.5 well after 1.26.6 shipped. That is exactly what happened: the published
# web-ui/admin-ui images carried a Caddy binary on stdlib 1.26.5 with
# CVE-2026-39821 and CVE-2026-46600, while every backend came out clean, because
# the backends pin and this stage did not. An exact pin provisions 1.26.6
# regardless of which base CI substitutes, and still refuses 1.27.
FROM ${GO_BUILDER_IMAGE} AS caddybuild
ENV GOTOOLCHAIN=go1.26.6 CGO_ENABLED=0
WORKDIR /caddybuild
RUN printf '%s\n' \
      'package main' \
      '' \
      'import (' \
      '	caddycmd "github.com/caddyserver/caddy/v2/cmd"' \
      '' \
      '	// Registers the standard Caddy modules (file_server, reverse_proxy,' \
      '	// encode, header, try_files, respond) that both Caddyfiles use.' \
      '	_ "github.com/caddyserver/caddy/v2/modules/standard"' \
      ')' \
      '' \
      'func main() { caddycmd.Main() }' \
    > main.go \
 && go mod init vistaplatform.local/caddybuild
# `go mod tidy` is required, not cosmetic: module-graph pruning leaves the
# go.sum entries for Caddy's own optional-module imports unresolved after a
# bare `go get`, and the build fails on ~10 "missing go.sum entry" errors.
RUN go get github.com/caddyserver/caddy/v2@v2.11.4 \
 && go get golang.org/x/net@v0.56.0 \
           golang.org/x/text@v0.39.0 \
           google.golang.org/grpc@v1.82.1 \
 && go mod tidy
RUN go build -o /go/bin/caddy .

# ---- runtime: Caddy static server (mirrors frontend-v2/Dockerfile.prod) ----
# Pinned by digest to defeat tag-mover attacks on docker.io/library/caddy.
# caddy:2-alpine → Caddy v2.11.4 on Alpine 3.23.5. Bumped from the 2.11.3 pin to
# clear the Trivy scan findings this base carried: Caddy CVE-2026-52844/52845
# (fix 2.11.4), the bundled Go x/crypto/x/net/go-jose + stdlib CVEs, and the Alpine
# OpenSSL CVE-2026-45447 (libssl3/libcrypto3 3.5.7-r0) + curl 8.19.0-r0. The
# runtime Caddy binary is then replaced with the Go-1.26.6 build above to clear
# the residual stdlib CVEs. See
# docsv4/internal/developer/security/2026-07-frontend-caddy-cve-remediation.md.
#
# The digest is UNCHANGED at 2026-08 and that is deliberate: `caddy:2-alpine` has
# not been rebuilt since 2026-06-24, so the tag still resolves to exactly this
# digest and there is no newer one to bump to. The Alpine package CVEs it now
# carries are cleared in the layer below instead.
FROM caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648

# Alpine package currency + surface removal.
#
# `apk upgrade` clears the OS-package CVEs this base accumulated while upstream
# did not rebuild it — at 2026-08 that is c-ares 1.34.6-r0 (CVE-2026-33630) and
# curl/libcurl 8.19.0-r0 (CVE-2026-5773, CVE-2026-6276). /etc/apk/repositories
# pins v3.23, so this is a patch-level upgrade within the base's own Alpine
# branch; it can never silently jump the image to a new Alpine release.
#
# Then delete curl outright. Nothing in this image uses it — Caddy is a static
# Go binary, the HEALTHCHECK below uses busybox wget, and the chart's probes are
# httpGet. It has no reverse dependencies, so `apk del` cascades away libcurl,
# c-ares, nghttp2, brotli, zstd, libidn2 and libunistring with it (32 → 23
# packages). Upgrading alone would have fixed today's five findings, but curl is
# a high-churn CVE surface that this image cannot use: removing it retires the
# whole class instead of re-running the version race every quarter.
RUN apk --no-cache upgrade && apk --no-cache del curl

# Swap in the Go-1.26.6-compiled Caddy binary (stdlib 1.26.6, patched deps).
# Unlike the stock caddy:2-alpine binary, this one carries NO file capabilities,
# so there is no cap_net_bind_service to strip (we bind 3007, never a privileged
# port, and the chart's strict containerSecurityContext drops ALL caps anyway).
# The prior `setcap -r` step is therefore gone — it would error on the cap-free
# binary ("no such attribute").
COPY --from=caddybuild /go/bin/caddy /usr/bin/caddy

RUN addgroup -g 1001 -S appgroup && adduser -u 1001 -S appuser -G appgroup

COPY --from=builder --chown=appuser:appgroup /repo/admin-ui-v2/dist /srv
COPY --chown=appuser:appgroup admin-ui-v2/Caddyfile /etc/caddy/Caddyfile

# Writable dirs for Caddy runtime state (image declares VOLUME /config /data)
RUN mkdir -p /config/caddy /data/caddy \
    && chown -R appuser:appgroup /config /data

USER appuser

EXPOSE 3007

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:3007/health || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
