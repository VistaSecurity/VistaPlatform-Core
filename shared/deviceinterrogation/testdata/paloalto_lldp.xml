  <result>
    <entry>
      <local-interface>ethernet1/1</local-interface>
      <lldp-neighbors>
        <entry>
          <more-neighbors>no</more-neighbors>
          <chassis-id>00:1b:17:00:00:01</chassis-id>
          <chassis-id-type>mac-address</chassis-id-type>
          <port-id>Gi1/0/24</port-id>
          <port-id-type>ifname</port-id-type>
          <port-description>uplink to fw-edge-01</port-description>
          <system-name>core-sw-1.example.net</system-name>
          <system-description>Cisco IOS Software, snmp community MUST-NOT-BE-COLLECTED</system-description>
          <system-capabilities>B,R</system-capabilities>
          <enabled-capabilities>B,R</enabled-capabilities>
          <management-address>198.51.100.1</management-address>
        </entry>
      </lldp-neighbors>
    </entry>
    <entry>
      <local-interface>ethernet1/2</local-interface>
