########################################################
# Host port overrides for local development
# Copy this file to .env and adjust if needed
########################################################

# =============================================================================
# Security Secrets (REQUIRED - Auto-generated by start-session.sh)
# =============================================================================
# These secrets are automatically generated when you run ./start-session.sh
# In production/smoke, use scripts/generate-ec2-smoke-env.mjs or generate-prod-env.mjs

# =============================================================================
# EMAIL (SMTP) — optional
# =============================================================================
# Leave SMTP_HOST empty and the platform will not require new users to verify
# their email address, because it would have no way to send them the link.
# Set it and verification is required automatically. Either way a platform
# admin can override the behaviour in admin-ui → Settings → Access.
#
# Configure this before inviting real users: without it, password reset and
# invitation emails also go nowhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com
FROM_NAME=Vista

# JWT_SECRET=                              # JWT signing secret (auto-generated)
# ENCRYPTION_MASTER_KEY=                   # Platform integrations credential encryption (auto-generated)
# INTERNAL_AUTH_SECRET=                    # Service-to-service HMAC authentication (auto-generated)

# =============================================================================
# Port Overrides (Optional - for port conflicts)
# =============================================================================
#
# Every port docker-compose.yml publishes on the host is listed here, moved into
# the 4xxxx range (host port = 4 + the container port) so the stack can run
# beside whatever else is already listening. The compose defaults are the plain
# low ports, and several of those are taken on any real machine — 9090/9091 by
# a Prometheus or by calico-node on a Kubernetes host, 4317/4318 by another OTel
# collector, 16686 by another Jaeger. An unlisted variable falls back to its low
# compose default, which is how a fresh `docker compose up` used to die at
# "address already in use" partway through starting the stack.
#
# scripts/audit-host-ports.mjs (run by `make audit`) fails if a published port
# has no entry here, or if two entries claim the same host port.

# Gateways and services
API_GATEWAY_HOST_PORT=48080
# Traefik Prometheus metrics (host); must differ from INVENTORY_SERVICE_HOST_PORT when both use defaults
TRAEFIK_METRICS_HOST_PORT=48099
AUTH_SERVICE_HOST_PORT=48081
INVENTORY_SERVICE_HOST_PORT=48082
COMPLIANCE_ENGINE_HOST_PORT=48083
CBOM_SERVICE_HOST_PORT=48084
SENSOR_MANAGER_HOST_PORT=48085
# sensor-manager also publishes a second, mTLS-only port for agent/sensor
# enrollment (USE_MTLS=true, container port 8443) — separate from its plain
# HTTP port above.
SENSOR_MANAGER_TLS_HOST_PORT=48443
CLUSTER_SENSOR_HOST_PORT=48088
ADMIN_SERVICE_HOST_PORT=48089
MONITORING_SERVICE_HOST_PORT=48091
RESOURCE_TRACKER_HOST_PORT=48092
TENANT_HEALTH_HOST_PORT=48093
DEVICE_INTERROGATION_SERVICE_HOST_PORT=48095
AUDIT_SERVICE_HOST_PORT=48096
NOTIFICATION_SERVICE_HOST_PORT=48097
PCAP_PROCESSOR_HOST_PORT=48098
MCP_SERVICE_HOST_PORT=48100
# discovery-processor listens on 8090, but 48090 is Adminer's (below), so this
# one breaks the 4+container-port pattern rather than collide with it.
DISCOVERY_PROCESSOR_SERVICE_HOST_PORT=48190

# PCAP processing configuration
PCAP_UPLOAD_TEMP_DIR=/tmp/pcap-uploads
PCAP_PROCESSING_TIMEOUT_MINUTES=5
PCAP_MAX_CONCURRENT_JOBS=4

# Frontends and dashboards
WEB_UI_HOST_PORT=43000
ADMIN_UI_HOST_PORT=43003
GRAFANA_HOST_PORT=43001
# URL of the tenant web-ui (used by admin-ui to link to design system pages)
VITE_WEB_UI_URL=http://localhost:3000

# Infra
POSTGRES_HOST_PORT=45432
REDIS_HOST_PORT=46379
INFLUXDB_HOST_PORT=48086
NATS_CLIENT_HOST_PORT=44222
NATS_HTTP_HOST_PORT=48222
ADMINER_HOST_PORT=48090
# Portainer CE HTTPS UI (dev override only; host port maps to container 9443)
PORTAINER_HTTPS_HOST_PORT=49443

# Observability (compose defaults 9091/16686/4317/4318 collide readily —
# calico-node holds 9091 on every Kubernetes node, and 4317/4318 are the
# standard OTLP ports any other collector on the box will already own)
PROMETHEUS_HOST_PORT=49091
JAEGER_UI_HOST_PORT=46686
OTEL_GRPC_HOST_PORT=44317
OTEL_HTTP_HOST_PORT=44318

# CORS (development)
# DEV_CORS_ALLOW_ANY=1 — Traefik gateway accepts any http(s) browser origin (default in dev).
# Set DEV_CORS_ALLOW_ANY=0 for a strict allowlist, then set TRAEFIK_DEV_EXTRA_CORS_ORIGINS and run make generate-gateway.
# DEV_CORS_ORIGINS=http://localhost:43000,http://localhost:43003

########################################################
# Secrets — REQUIRED, no defaults in docker-compose
# In production: use Docker secrets, Vault, or CI env vars
########################################################

# PostgreSQL
POSTGRES_DB=crypto_inventory
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=crypto_pass_dev

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpass123
INFLUXDB_TOKEN=dev-token-1234567890
INFLUXDB_ORG=crypto-inventory
INFLUXDB_BUCKET=metrics

# Redis
REDIS_PASSWORD=redis_pass_dev

# NATS
NATS_USER=nats_user
NATS_PASSWORD=nats_pass_dev

# JWT & Encryption
JWT_SECRET=dev-secret-key-change-in-production
ENCRYPTION_MASTER_KEY=dev-master-key-change-in-production

# Internal service auth (HMAC shared secret for service-to-service calls)
INTERNAL_AUTH_SECRET=dev-internal-auth-secret-change-in-production

# Force the Secure flag on admin-service auth cookies regardless of X-Forwarded-Proto.
# Set to true in production where TLS is always terminated upstream — protects against
# a misconfigured proxy dropping the header and downgrading auth cookies to non-Secure.
# Leave unset (or false) for local HTTP development.
# ENFORCE_SECURE_COOKIES=true

# Subscription tier a self-signup tenant is created on (auth-service). Defaults to
# 'community' — the Core floor: unlimited capacity, no paid capability. Without a tier
# a tenant resolves every capacity cap to the conservative billable_items default (0
# sensors, 0 assets) and cannot register a sensor at all. Set to 'free' only on a
# commercial multi-tenant SaaS, where new signups belong on the 14-day trial tier.
# DEFAULT_SIGNUP_TIER=community

# Optional: attribute monitoring-service host metrics to a specific tenant (overrides auto-pick).
# If unset, monitoring uses the newest active row in tenants (works after qa-platform seed with no extra config).
# RESOURCE_METRICS_TENANT_ID=

# Resource-tracking middleware (Go services → resource-tracker): circuit breaker is off when ENV=development.
# Override: RESOURCE_TRACKING_DISABLE_CIRCUIT_BREAKER=true|false, RESOURCE_TRACKING_ENABLE_CIRCUIT_BREAKER=true
#
# Traefik per-service circuit breakers: off for dynamic-development.yaml after `make generate-gateway`.
# Re-enable in local gateway: ENABLE_GATEWAY_CIRCUIT_BREAKER=true make generate-gateway

# Grafana
GRAFANA_ADMIN_PASSWORD=admin123

# Platform SSO (optional - enables "Sign up with Google/Microsoft" on registration page)
# Obtain from Google Cloud Console / Microsoft Entra admin portal.
# If not set, social signup buttons won't appear; email/password registration still works.
# PLATFORM_GOOGLE_CLIENT_ID=
# PLATFORM_GOOGLE_CLIENT_SECRET=
# PLATFORM_MICROSOFT_CLIENT_ID=
# PLATFORM_MICROSOFT_CLIENT_SECRET=

# Stripe (optional - required for billing features)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Billing Background Workers
BILLING_WEBHOOK_WORKER_ENABLED=true
BILLING_DUNNING_WORKER_ENABLED=true
BILLING_DUNNING_CRON_SCHEDULE="0 */6 * * *"
BILLING_TRIAL_WORKER_ENABLED=true
BILLING_TRIAL_CRON_SCHEDULE="0 9 * * *"
BILLING_GRACE_PERIOD_DAYS=7
BILLING_INVOICE_PDF_ENABLED=true

# Compliance-engine reconcile worker (ADR-0014 continuous materialized evaluation).
# Kill switch: set to "false" to disable BOTH the NATS reconcile consumer and job
# enqueuing, degrading to on-asset-change evaluation only. Any other value (including
# unset) keeps it on.
COMPLIANCE_RECONCILE_WORKER_ENABLED=true

# Automatic active scanning (inventory-service). The platform probes a newly
# observed INTERNAL host as soon as it appears, and probes every internal host
# again once the tenant's rescan interval has elapsed.
#
# Kill switch: set to "false" to stop both triggers for the whole deployment.
# Any other value (including unset) keeps it on. This is the OPERATOR's switch;
# each tenant's own controls live at Settings -> Discovery -> Active Scanning.
DISCOVERY_AUTO_SCAN_WORKER_ENABLED=true
# How often the sweep LOOKS for hosts that have become due. Not the rescan
# interval — that is the tenant's, in hours, on their settings page.
DISCOVERY_AUTO_SCAN_SWEEP_INTERVAL=15m
# How often tenants that reported a new observation are looked at.
DISCOVERY_AUTO_SCAN_TRIGGER_INTERVAL=60s
# Ranges the platform must never probe on its own initiative, comma separated.
# Its own addresses are excluded automatically; this is for the cluster's
# pod/service CIDRs, which it cannot discover from inside a pod.
DISCOVERY_AUTO_SCAN_EXCLUDE_CIDRS=

# Sensor discovery retention (discovery-processor-service). Once a raw
# sensor_discoveries row has been PROCESSED (materialized, suppressed, deferred
# or routed — never an unprocessed row), it is purged after the retention
# window so the ingestion queue does not grow without bound.
#
# Kill switch: set to "false" to stop the sweep entirely. Any other value
# (including unset) keeps it on.
SENSOR_DISCOVERY_RETENTION_ENABLED=true
# How many hours a PROCESSED row is kept before the sweep deletes it. Default
# 168 (7 days).
SENSOR_DISCOVERY_RETENTION_HOURS=168

# The LEARNED half of the asset classifier (asset-inventory workstream 4.2).
# Kill switch: set to "false" (or "0"/"off"/"no") to run the curated
# classification RULES alone — they go on proposing exactly as before, and
# nothing is proposed where they cannot decide. Any other value (including
# unset) keeps it on.
#
# This is NOT the same control as the seam's `classifier: none`, which turns off
# class proposals altogether. The model never sets a class either way: it
# proposes, above a 0.80 probability floor, and only where the rules decided
# nothing or decided two. See docsv4/internal/developer/standards/
# CLASSIFICATION_RULES.md → "The learned classifier".
CLASSIFIER_MODEL_ENABLED=true

# Platform catalogue mirror feeds (admin-service): end-of-life (endoflife.date)
# and vulnerability (NVD 2.0 + osv.dev) → eol_catalogue / vulnerability_catalogue.
# Kill switch: "false" stops BOTH the scheduled passes and the manual Sync-now
# button in Catalog ▸ End-of-life / Vulnerability feed, which then answers 409.
# Any other value (including unset) keeps it on. An offline bundle can still be
# imported with the feeds off. See docsv4/core/operate/catalogs.md.
CATALOG_FEEDS_ENABLED=true
# How often a scheduled pass runs, and how long after boot the first one fires
# (the delay staggers replicas so a rolling restart is not N simultaneous passes).
CATALOG_FEEDS_INTERVAL=24h
CATALOG_FEEDS_STARTUP_DELAY=2m
# NVD API key (optional, free from https://nvd.nist.gov/developers/request-an-api-key).
# Without it NVD allows 5 requests per rolling 30 seconds and answers 403 — not
# 429 — when you exceed that; with it, 50. The mirror paces itself either way.
NVD_API_KEY=
# osv.dev ecosystems to mirror, comma-separated, matching the bucket names at
# https://osv-vulnerabilities.storage.googleapis.com (e.g. "Debian,Ubuntu,Alpine",
# and optionally "npm,PyPI,Go,Maven"). Each adds one bulk download per pass.
OSV_ECOSYSTEMS=Debian,Ubuntu,Alpine

# Notification delivery retry (notification-service).
# A channel send that fails is enqueued on notification_delivery_queue and retried
# with exponential backoff (1m, 2m, 4m, ... capped at 1h), scoped to the individual
# failed channel so a retry cannot duplicate a delivery that already succeeded.
# After the last attempt the row is left as a durable status='failed' record.
# Kill switch: "false" disables BOTH enqueuing and the draining worker, degrading
# to one attempt with no second chance. Any other value (including unset) keeps it on.
NOTIFICATION_DELIVERY_RETRY_ENABLED=true
# Attempts per (notification, channel) before giving up. Values < 1 are ignored.
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5

# =============================================================================
# AI provider (ADR-0008 — AI-native, never AI-dependent)
# =============================================================================
# Which model endpoint the generative AI seams (enricher, narrator, query,
# author, remediator) reach through. Read by shared/ai.NewFromEnv.
#
# "none" is the default and a complete, supported configuration: every seam is
# present and returns its documented null answer, the product is fully
# functional, and nothing is sent anywhere. Air-gapped installs leave it here.
#
# An unrecognised value logs a warning and falls back to "none" — it never
# fails a service to start, and it never silently pretends to be configured.
#
# Recognised: none | anthropic | openai_compat
#
# "anthropic" and "openai_compat" are Enterprise (ADR-0008 edition placement).
# A Core build does not contain them, so naming one there gets you "none" plus
# a warning naming the provider — the capability is absent and says so.
AI_PROVIDER=none

# Endpoint override. Optional for "anthropic" (defaults to the public API);
# REQUIRED for "openai_compat", which is the customer's own endpoint and has no
# sensible default. Write it however the server's own docs do — the /v1 root is
# usual — and the client appends the rest of the path:
#   http://ollama.internal:11434/v1      (Ollama)
#   http://vllm.internal:8000/v1         (vLLM)
#   http://localhost:1234/v1             (LM Studio)
#   https://api.openai.com/v1            (hosted OpenAI)
AI_BASE_URL=

# Model id. Empty means the provider's default for "anthropic"; REQUIRED for
# "openai_compat", where only the operator knows what their endpoint serves.
AI_MODEL=

# Which environment variable holds the API key. The key itself is NEVER stored
# in configuration, a database row, or a log line — only the name of the
# variable is, and the value is read at the moment of use. Empty means the
# provider's conventional variable: ANTHROPIC_API_KEY, or OPENAI_API_KEY.
#
# A bearer token is optional for "openai_compat": a local Ollama or LM Studio
# has no credential at all.
AI_API_KEY_ENV=

# Permit a model endpoint on a loopback, private, or link-local address.
#
# Default false. Every other outbound call in this codebase refuses a private
# address, because a tenant-supplied host pointing at one means someone is
# aiming us at our own cluster. Here a private address is ALSO the legitimate
# case — your own Ollama or vLLM beside the platform — so it becomes an
# explicit decision an operator records, rather than a guard quietly dropped.
#
# Set this to true when AI_BASE_URL is your own self-hosted endpoint. Leave it
# false when pointing at a hosted API.
AI_ALLOW_PRIVATE_ENDPOINTS=false

# Response cap, and the per-attempt HTTP timeout. Defaults (16000 tokens, 120s)
# suit both a hosted API and a self-hosted endpoint on modest hardware; a
# retried call can take up to three timeouts plus backoff.
AI_MAX_TOKENS=
AI_TIMEOUT=

# =============================================================================
# Scalability Tuning (Optional - defaults are suitable for development)
# =============================================================================

# Database connection pool (read by shared/database.DefaultPoolConfigFromEnv)
# Lower DB_MAX_OPEN_CONNS behind RDS Proxy (e.g., 15); higher for direct connect.
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=300       # seconds
# DB_CONN_MAX_IDLE_TIME=60       # seconds

# Read replica URL (falls back to DATABASE_URL if unset)
# DATABASE_READ_URL=

# NATS JetStream stream replication (1 for dev, 3 for production HA cluster)
NATS_STREAM_REPLICAS=1

# SIEM CEF/LEEF DeviceVendor field (audit-service + monitoring-service exports).
# Defaults to "Vista Platform". Customers mid-rebrand whose SIEM parsers/correlation
# rules still key on the legacy "CryptoInventory" vendor can override this to
# CryptoInventory until they re-tune their SIEM side. See issue #193.
# SIEM_CEF_VENDOR=Vista Platform

# Redis pool sizing
# REDIS_POOL_SIZE=25
# REDIS_MIN_IDLE_CONNS=5
