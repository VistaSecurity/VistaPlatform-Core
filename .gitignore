# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
artifacts/sensor/
artifacts/device-agent/

# Go binaries (root directory only - actual builds go to bin/)
/monitoring-service
/auth-service
/admin-service
/inventory-service
/compliance-engine
/sensor-manager
/report-generator
/cluster-sensor-service

# Go test coverage output
coverage.out

# Go workspace file
# go.work is intentionally committed — required for CI builds and Dockerfile builds
# go.work
vendor/

# Environment variables (auto-generated by scripts/generate-dev-env.sh)
.env
.env.local
.env.*

# Docker Hardened Images credentials (personal, never commit)
# Format: line 1 = Docker Hub username, line 2 = personal access token
dhi_pat

# AWS credentials for ECR push and deployment (personal, never commit)
# Format: KEY=VALUE pairs — see aws_credentials.example
aws_credentials

# Docker Hub credentials for image mirror push (personal, never commit)
# Format: line 1 = Docker Hub username, line 2 = access token
dockerhub_creds


# IDE files
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Node modules
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Database files
*.sqlite3
*.db

# Application specific
config/local/
temp/
tmp/
.tmp/
# Generated report files (not the web-ui reports components)
/reports/
/models/
*.key
*.pem

# Exception: the PUBLIC half of the Enterprise content-signing key. A public key
# is not a secret — it is what lets a customer confirm which key their content
# bundle was signed under, and the chart needs it to verify the bundle. It must
# be committed, so the blanket *.pem rule above is negated for this one file.
!services/compliance-engine/ee/content/verify-key.pem

# EKS deploy secrets (generated by scripts/deploy-eks-interactive.sh)
k8s/eks/deploy.env

# RKE2 deploy values (generated by scripts/deploy-rke2-interactive.sh)
config/rke2/values.env
# RKE2 generated api-gateway Traefik ConfigMap (regenerated each deploy)
k8s/rke2/configmap-api-gateway-traefik.yaml
# RKE2 install render directory (manifests with placeholders substituted)
.rke2-render/
# RKE2 patched dynamic config (extra CORS origins applied)
config/traefik/dynamic-production.rke2.yaml

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Docker volumes
postgres_data/
influx_data/
redis_data/
.vite/

# Local development files (not for version control)
*_ISSUE.md
*_SUMMARY.md
*_NOTES.md
*_DEBUG.md
*_TEMP.md
.local-dev/

# UI runtime configs (generated from registry)
web-ui/public/config/config.json
admin-ui/public/config/config.json

# Development config overrides (tracked)
!web-ui/public/config/config.dev.json
!admin-ui/public/config/config.dev.json

# Generated artifacts - TRACKED in version control
# These files are generated from standards/service-registry.yaml
# but must be committed to ensure CI/CD consistency
# Run `make generate` to update them, then commit the changes
services/*/main

# Generated Traefik configs (Docker mounts config/traefik/ directly; these are unused duplicates)
config/generated/traefik-*.yaml

# Generated compose config (run make generate or start-session to create)
config/generated/docker-compose-services.yml

# Generated chart backends preview (run make generate-chart-values to create)
charts/vistaplatform/values-backends.generated.yaml

# Enterprise content bundle staged into the chart (make stage-content-bundle,
# and the release workflow's package step). NEVER commit these: charts/ is not
# touched by the open-source repo cut (which deletes services/*/ee/), so a
# committed copy here would ship the licensed framework content in the public
# repository. The source of truth is services/compliance-engine/ee/content/.
charts/vistaplatform/files/ee/

# Stray build artifacts (root-level binaries)
/cmd
/main

# Stray build artifacts (in-directory `go build` outputs — binary named
# after its own directory). Real builds go to bin/.
services/*/admin-service
services/*/audit-service
services/*/auth-service
services/*/cbom-service
services/*/cluster-sensor-service
services/*/compliance-engine
services/*/device-interrogation-service
services/*/discovery-processor-service
services/*/inventory-service
services/*/mcp-service
services/*/monitoring-service
services/*/notification-service
services/*/pcap-processor
services/*/resource-tracker-service
services/*/sensor-manager
services/*/tenant-health-service
sensor/crypto-sensor
sensor/simple-sensor
device-agent/device-agent
tools/license-issue/license-issue

# mTLS certificates (development only - never commit private keys)
config/certs/*.pem
config/certs/*.csr
config/certs/*.srl

# Customer-specific Helm values at the project root — usually contains
# transient install-time workarounds (e.g. the v0.1.0 install's PSA
# relaxations). Anchored to /values-customer.yaml only — values-customer.yaml
# files inside customer-packages/<name>/ are tracked (they reference
# Kubernetes Secrets by name; no inline secrets).
/values-customer.yaml

# Lab internal CA materials — kept in project root only until moved to RoboForm
/ca-tmp/
/CA_PASSPHRASE.txt

# Claude Code worktree state (per-clone harness metadata, not source)
.claude/

# Playwright output (admin-ui E2E artifacts; regenerated on every run)
admin-ui/test-results/

# Terraform local state and secrets
infrastructure/terraform/terraform.tfvars
infrastructure/terraform/.terraform/
infrastructure/terraform/.terraform.lock.hcl
infrastructure/terraform/terraform.tfstate
infrastructure/terraform/terraform.tfstate.backup
aws_credentials

# Design kits / mocks staged for the v2 UI rebuilds (source-of-truth during build, not shipped)
_incoming/

# QA Platform lab fixtures export (contains plaintext lab secrets)
lab-fixtures.yaml
# TypeScript incremental build state. `tsc -b` from the repo root emits one
# per referenced workspace, so this is a glob rather than the single path it
# used to be — root `tsc -b` was broken until 2026-08-06 and only ever
# produced the qa-platform one.
*.tsbuildinfo
