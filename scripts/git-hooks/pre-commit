#!/usr/bin/env bash
# Pre-commit hook: run the fast drift audits before allowing a commit.
#
# Runtime budget: <2s on a warm tree. Covers:
#   - audit-from-registry        (registry self-consistency)
#   - audit-compose-secrets      (compose envs ↔ registry required_secrets)
#   - audit-chart-parity         (chart values+templates ↔ registry, strict)
#   - audit-permissions          (web-ui permission gates ↔ seed.sql
#                                 tenant_permissions, strict)
#   - validate-dockerfiles       (per-Dockerfile lint + structural parity
#                                 across .dev/.prod/.licensed/.dist)
#
# Skipped here because they're slower or non-blocking:
#   - make standards-check       (also runs lint + logging validators —
#                                 fine for CI, too slow for every commit)
#   - frontend lint/format       (run via `make lint` / `make format`)
#   - go test / go build         (run via `make test-unit` / build targets)
#
# Bypass when you know what you're doing:
#   git commit --no-verify
#
# Installed by `make install-git-hooks` (sets core.hooksPath to this dir).

set -e
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "🔍 pre-commit: running drift audits..."

# Both targets are make-driven so the hook stays in sync with what
# `make audit` and CI run. The make wrappers also do an idempotent
# `npm install` for scripts/ if node_modules is missing.
make --no-print-directory audit
make --no-print-directory validate-dockerfiles

echo "✅ pre-commit: drift audits passed"
